# Steuerdatei für den Workflow "CL Vorschau-Spielerpool".
#
# Warum es diese Datei gibt: `workflow_dispatch` (Actions → Run workflow)
# funktioniert erst, wenn die Workflow-Datei auf dem Default-Branch liegt.
# Solange der Workflow nur auf einem Feature-Branch existiert, lässt er sich
# über einen Push AUF DIESE DATEI auslösen. Nach dem Merge nach main ist der
# reguläre Weg "Actions → CL Vorschau-Spielerpool → Run workflow"; diese
# Datei kann dann ersatzlos gelöscht werden.
#
# Auslösen: einen Wert ändern (z. B. RUN hochzählen) und pushen.

# Beliebiger Wert – nur damit sich die Datei ändert und der Push den Lauf startet.
RUN=8

# Turnier-Key aus tournament-config.js.
TOURNAMENT_KEY=cl2627

# Saison der nationalen Ligatabellen (leer = Turnier-Saison minus 1).
SOURCE_SEASON=

# 1 = nur Klubs ermitteln und loggen (keine Kader-Calls, keine Dateien).
PROBE=1

# Debug: nur die ersten N Klubs laden (0 = alle).
MAX_TEAMS=0

# 1 = Spieler ohne Stammdaten bei api-football verwerfen (kein Geburtsdatum,
# keine Nationalität – meist Nachwuchsspieler). Default aus, weil
# data-cl2526.js solche Einträge ebenfalls enthält.
SKIP_INCOMPLETE=0

# 1 = Ergebnis committen und auf den Branch pushen (bei PROBE=1 wirkungslos).
COMMIT=0

# Diagnose: kommaseparierte player.id -> nur Rohdaten dieser Spieler ausgeben
# und beenden (keine Dateien). Leer lassen fuer normale Laeufe.
DIAG_PLAYER_IDS=
