rules_version = '2';

// Firestore Security Rules for DreamTeam – WM 2026.
//
// Diese Datei ist die Quelle der Wahrheit fuer die im Firebase-Projekt
// hinterlegten Security Rules. Sie ist absichtlich kompakt gehalten, damit
// sie 1:1 in die Firebase Console (Firestore -> Rules) reinkopiert werden
// kann, ohne dass der dortige Parser sich an Funktions-Argumenten,
// mehrzeiligen Ausdruecken oder dekorativen Kommentarbloecken stoesst.
//
// Wichtige Eigenschaften:
//   1) Public-Reads nur fuer die WM-2026-Collections, das app_meta-Dokument
//      und das oeffentliche Fixture-Bundle.
//   2) Team-Writes verlangen verifizierte E-Mail und eigenes Doc
//      (matched per userId ODER userEmailLower). NEUE Team-Dokumente
//      muessen zudem die eigene UID als Doc-ID tragen -> pro Account kann
//      es nur EIN Team geben (Admin ausgenommen: Testteams).
//   3) Team-Writes sind nach Anpfiff (2026-06-11 19:00 UTC) gesperrt;
//      Admins bleiben schreibberechtigt. Zusaetzlich kann der Admin ueber
//      das Feld `lateSubmitOpen` im Meta-Dokument (app_meta/turnier_wm2026)
//      die Einreichung global fuer ALLE verifizierten Nutzer wieder oeffnen.
//   4) Team-Schema: exakt 15 Spieler, erlaubte Felder als Allowlist.
//   5) Verifizierte User duerfen den teamsVersion-Counter im app_meta-Doc
//      nur um +1 erhoehen; Admin darf alles.
//   6) Champions League: Reads und Team-Writes fuer die produktive Saison
//      (cl2627, 'Teams CL 2026-27'). Neue Teams/Loeschungen sind bis zum
//      ersten Ligaphasen-Spiel (2026-09-08 16:45 UTC) erlaubt, Updates
//      dauerhaft (Transferfenster waehrend der Saison).
//   7) Tippgruppen ('tippgruppen', siehe tippgruppen.js): get per Doc-ID
//      fuer jeden Angemeldeten (die zufaellige Doc-ID im Einladungs-Link
//      ist das Geheimnis privater Gruppen), list NUR fuer oeffentliche
//      Gruppen oder die eigene Mitgliedschaft (query-gebunden). Create nur
//      als verifizierter Ersteller mit sich selbst als einzigem Mitglied;
//      Update ausschliesslich Selbst-Beitritt/-Austritt; Delete nur
//      Ersteller oder Admin.
//   8) Default-Deny fuer alles andere.
//
// Hinweis: Collection-Namen mit Leerzeichen ('Teams WM 2026', ...) lassen
// sich nicht direkt in match-Pfade schreiben. Wir matchen deshalb auf
// match /{collection}/{docId} und vergleichen den Namen als String.

service cloud.firestore {
  match /databases/{database}/documents {

    // -------------------------------------------------------------------
    // Helper Functions (keine Parameter -> Console-safe)
    // -------------------------------------------------------------------

    // Abgabe-Deadline (Anpfiff WM 2026): 2026-06-11 21:00 Europe/Zurich
    // = 2026-06-11 19:00:00 UTC = 1781204400000 ms.
    function isBeforeTeamDeadline() {
      return request.time.toMillis() < 1781204400000;
    }

    // Admin-gesteuerter Not-/Nachzuegler-Schalter. Setzt der Admin im
    // Meta-Dokument (app_meta/turnier_wm2026) das Feld `lateSubmitOpen`
    // auf true, duerfen ALLE verifizierten Nutzer weiterhin Teams
    // einreichen/aendern, obwohl der Anpfiff bereits vorbei ist. Der
    // Schalter wird ueber den Dev-Knopf im Team-Builder (nur fuer Admins
    // sichtbar) umgelegt und gilt dann global fuer alle Clients.
    function lateSubmitOpen() {
      return exists(/databases/$(database)/documents/app_meta/turnier_wm2026)
          && get(/databases/$(database)/documents/app_meta/turnier_wm2026)
               .data.get('lateSubmitOpen', false) == true;
    }

    // Teams duerfen geschrieben werden, wenn wir vor der Deadline sind,
    // der Admin den Nachzuegler-Schalter aktiviert hat, oder der Anfragende
    // selbst Admin ist.
    function teamWritesAllowed() {
      return isBeforeTeamDeadline() || lateSubmitOpen() || isAdmin();
    }

    // Abgabe-Deadline Champions League 2026/27: erster Ligaphasen-Anpfiff
    // 2026-09-08 18:45 Europe/Zurich = 2026-09-08 16:45:00 UTC
    // = 1788885900000 ms (fruehestmoeglicher Anstoss des ersten Abends).
    // Quelle: DREAMTEAM_START in tournament-config.js (cl2627) – beide
    // Werte muessen zusammen gepflegt werden.
    function isBeforeClTeamDeadline() {
      return request.time.toMillis() < 1788885900000;
    }

    // Nachzuegler-Schalter der CL: identisch zum WM-Schalter, nur im
    // CL-Meta-Dokument (app_meta/turnier_cl2627).
    function clLateSubmitOpen() {
      return exists(/databases/$(database)/documents/app_meta/turnier_cl2627)
          && get(/databases/$(database)/documents/app_meta/turnier_cl2627)
               .data.get('lateSubmitOpen', false) == true;
    }

    // NEUE Teams (und Loeschungen) der CL 2026/27: bis zum ersten
    // Ligaphasen-Spiel, danach nur noch per Nachzuegler-Schalter oder als
    // Admin. UPDATES sind bewusst NICHT hierdurch gedeckt – die CL hat ein
    // Transferfenster, das waehrend der Saison laeuft (siehe CL_TRANSFERS),
    // deshalb muessen bestehende Teams auch nach dem Anpfiff aenderbar
    // bleiben. Die Transfer-Obergrenze prueft der Client; die Rules
    // begrenzen hier nur die Groesse der transfers-Liste (Schema).
    function clTeamCreatesAllowed() {
      return isBeforeClTeamDeadline() || clLateSubmitOpen() || isAdmin();
    }

    function isAdmin() {
      return request.auth != null
          && request.auth.uid == 'lSw9kxsnp8a7qb0s7UzuTQVwRAu1';
    }

    function isVerified() {
      return request.auth != null
          && request.auth.token.email_verified == true
          && request.auth.token.email is string
          && request.auth.token.email.size() > 0;
    }

    function authEmailLower() {
      return request.auth.token.email.lower();
    }

    function incomingEmailOk() {
      return isVerified()
          && request.resource.data.userEmailLower is string
          && request.resource.data.userEmailLower == authEmailLower();
    }

    function existingEmailOk() {
      return isVerified()
          && 'userEmailLower' in resource.data
          && resource.data.userEmailLower is string
          && resource.data.userEmailLower == authEmailLower();
    }

    function ownsExistingByUid() {
      return isVerified()
          && 'userId' in resource.data
          && resource.data.userId == request.auth.uid;
    }

    function isOwnerOfExisting() {
      return ownsExistingByUid() || existingEmailOk();
    }

    function isTeamsVersionBumpOnly() {
      return request.resource.data.diff(resource.data).affectedKeys()
                .hasOnly(['teamsVersion', 'teamsUpdatedAt', 'year'])
          && request.resource.data.teamsVersion is int
          && request.resource.data.teamsVersion ==
               resource.data.get('teamsVersion', 0) + 1
          && request.resource.data.teamsUpdatedAt is int
          && request.resource.data.teamsUpdatedAt > 0;
    }

    // Schema-Allowlist fuer Team-Dokumente.
    // Wichtig: GENAU 15 Spieler (passt zur UI-Validation count === 15).
    function incomingTeamSchemaOk() {
      return request.resource.data.keys().hasAll(
                ['userId', 'userEmailLower', 'manager', 'players']
             )
          && request.resource.data.keys().hasOnly([
                'userId',
                'userEmail',
                'userEmailLower',
                'manager',
                'managerNormalized',
                'players',
                'status',
                'timestamp',
                'updatedAt',
                // CL-Transferfenster (optional; WM setzt diese Felder nie):
                // Historie der Transfers + Kapitaen des Start-15 fuer die
                // zeitbasierte Wertung. Innere Struktur prueft der Client;
                // hier nur Typ + Obergrenze (max. 2 Transfers/Saison).
                'transfers',
                'initialCaptain'
             ])
          && (
                !('transfers' in request.resource.data)
                || (
                    request.resource.data.transfers is list
                    && request.resource.data.transfers.size() <= 2
                )
             )
          && (
                !('initialCaptain' in request.resource.data)
                || request.resource.data.initialCaptain is string
             )
          && request.resource.data.userId is string
          && request.resource.data.userId.size() >= 1
          && request.resource.data.userId.size() <= 128
          && request.resource.data.userEmailLower is string
          && request.resource.data.userEmailLower.size() >= 3
          && request.resource.data.userEmailLower.size() <= 254
          && request.resource.data.userEmailLower ==
               request.resource.data.userEmailLower.lower()
          && request.resource.data.manager is string
          && request.resource.data.manager.size() >= 1
          && request.resource.data.manager.size() <= 80
          && request.resource.data.players is list
          && request.resource.data.players.size() == 15;
    }

    function validTeamCreate() {
      return isVerified()
          && request.resource.data.userId == request.auth.uid
          && incomingEmailOk()
          && incomingTeamSchemaOk();
    }

    // Hinweis zur Doc-ID neuer Team-Dokumente:
    //
    // Der Client legt neue Teams unter der UID des Nutzers an
    // (Doc-ID == uid, siehe saveTeamForUser in auth.js) statt unter einer
    // zufaelligen Auto-ID. Die Rules erzwingen das unten in den
    // create-Zweigen mit `docId == request.auth.uid`. Damit ist ein
    // ZWEITES Team fuer denselben Account technisch ausgeschlossen – auch
    // dann, wenn zwei Tabs/Geraete gleichzeitig einreichen und beide
    // vorher "noch kein Team vorhanden" gelesen haben: Der zweite
    // Schreibvorgang trifft zwangslaeufig dasselbe Dokument und ist damit
    // ein Update, kein zweites Team.
    //
    // Bestehende Teams mit alter Auto-ID sind NICHT betroffen: die
    // Bedingung gilt nur fuer `create`; Updates und Deletes laufen
    // unveraendert ueber isOwnerOfExisting().
    //
    // Der Admin ist ausgenommen (`isAdmin()`), weil der Testteam-Modus
    // bewusst mehrere Teams unter einem Account anlegt.
    //
    // Die Bedingung steht absichtlich inline und nicht in einer
    // Hilfsfunktion: `docId` stammt aus dem match-Block weiter unten und
    // ist hier oben nicht sichtbar.

    function validTeamUpdate() {
      return isVerified()
          && request.resource.data.userId == request.auth.uid
          && incomingEmailOk()
          && incomingTeamSchemaOk()
          && isOwnerOfExisting();
    }

    function validTeamDelete() {
      return isVerified() && isOwnerOfExisting();
    }

    // -------------------------------------------------------------------
    // Tippgruppen (Collection 'tippgruppen', Client: tippgruppen.js).
    //
    // Ein Dokument: { name, visibility ('public'|'private'), creatorUid,
    // creatorName, memberUids (list), memberNames (map uid->name),
    // createdAt }. Private Gruppen leben vom Geheimnis ihrer zufaelligen
    // Doc-ID (Einladungs-Link); list-Queries duerfen sie deshalb nie
    // ausliefern, ein gezieltes get mit bekannter ID schon.
    // -------------------------------------------------------------------

    function tippgruppeSchemaOk() {
      return request.resource.data.keys().hasAll(
                ['name', 'visibility', 'creatorUid', 'creatorName', 'memberUids', 'memberNames', 'createdAt']
             )
          && request.resource.data.keys().hasOnly(
                ['name', 'visibility', 'creatorUid', 'creatorName', 'memberUids', 'memberNames', 'createdAt']
             )
          && request.resource.data.name is string
          && request.resource.data.name.size() >= 1
          && request.resource.data.name.size() <= 60
          && (request.resource.data.visibility == 'public'
              || request.resource.data.visibility == 'private')
          && request.resource.data.creatorName is string
          && request.resource.data.creatorName.size() >= 1
          && request.resource.data.creatorName.size() <= 80
          && request.resource.data.memberUids is list
          && request.resource.data.memberNames is map;
    }

    // Anlegen: verifiziert, selbst der Ersteller und das einzige Mitglied.
    function validTippgruppeCreate() {
      return isVerified()
          && tippgruppeSchemaOk()
          && request.resource.data.creatorUid == request.auth.uid
          && request.resource.data.memberUids == [request.auth.uid]
          && request.resource.data.memberNames.keys().hasOnly([request.auth.uid])
          && request.resource.data.memberNames[request.auth.uid] is string
          && request.resource.data.memberNames[request.auth.uid].size() >= 1
          && request.resource.data.memberNames[request.auth.uid].size() <= 80
          && request.resource.data.createdAt == request.time;
    }

    // Beitritt: exakt die eigene UID kommt dazu, sonst bleibt alles gleich.
    function tippgruppeSelfJoin() {
      return request.resource.data.memberUids.hasAll(resource.data.memberUids)
          && request.resource.data.memberUids.size() == resource.data.memberUids.size() + 1
          && request.resource.data.memberUids.size() <= 200
          && (request.auth.uid in request.resource.data.memberUids)
          && !(request.auth.uid in resource.data.memberUids);
    }

    // Austritt: exakt die eigene UID verschwindet, sonst bleibt alles gleich.
    function tippgruppeSelfLeave() {
      return resource.data.memberUids.hasAll(request.resource.data.memberUids)
          && request.resource.data.memberUids.size() == resource.data.memberUids.size() - 1
          && !(request.auth.uid in request.resource.data.memberUids)
          && (request.auth.uid in resource.data.memberUids);
    }

    // Updates aendern NUR die Mitgliedschaft (memberUids + eigener Eintrag
    // in memberNames) – Name, Sichtbarkeit und Ersteller sind unveraenderlich.
    function validTippgruppeUpdate() {
      return isVerified()
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['memberUids', 'memberNames'])
          && request.resource.data.memberUids is list
          && request.resource.data.memberNames is map
          && request.resource.data.memberNames.diff(resource.data.memberNames)
               .affectedKeys().hasOnly([request.auth.uid])
          && (tippgruppeSelfJoin() || tippgruppeSelfLeave())
          && (
                !(request.auth.uid in request.resource.data.memberNames)
                || (
                    request.resource.data.memberNames[request.auth.uid] is string
                    && request.resource.data.memberNames[request.auth.uid].size() <= 80
                )
             );
    }

    function validTippgruppeDelete() {
      return isVerified()
          && ('creatorUid' in resource.data)
          && (resource.data.creatorUid == request.auth.uid || isAdmin());
    }

    // -------------------------------------------------------------------
    // Public + Team Writes
    //
    // Collection-Namen werden per String-Vergleich gegen die exakten
    // WM-2026-Namen geprueft. Damit kann nicht versehentlich eine
    // Test-/Alt-Collection mit aehnlichem Namen oeffentlich werden.
    // -------------------------------------------------------------------

    match /{collection}/{docId} {

      allow read:
        if collection == 'Teams WM 2026'
        || collection == 'Spiele WM 2026'
        || collection == 'Punkte Spieler WM 2026'
        || (collection == 'app_meta' && docId == 'turnier_wm2026')
        || (collection == 'public_cache' && (
             docId == 'wm2026_fixtures'
          || docId == 'wm2026_points_delta_current'
          || docId == 'wm2026_points_shard_00'
          || docId == 'wm2026_points_shard_01'
          || docId == 'wm2026_points_shard_02'
          || docId == 'wm2026_points_shard_03'
          || docId == 'wm2026_points_shard_04'
          || docId == 'wm2026_points_shard_05'
          || docId == 'wm2026_points_shard_06'
          || docId == 'wm2026_points_shard_07'
          || docId == 'wm2026_points_shard_08'
          || docId == 'wm2026_points_shard_09'
          || docId == 'wm2026_points_shard_10'
          || docId == 'wm2026_points_shard_11'
          || docId == 'wm2026_points_shard_12'
          || docId == 'wm2026_points_shard_13'
          || docId == 'wm2026_points_shard_14'
          || docId == 'wm2026_points_shard_15'
        ))
        // ── Champions League (cl2627): Reads fuer alle. Die Team-WRITES
        //    folgen unten; Server-Writes (Fixtures/Punkte) laufen ohnehin
        //    ueber das Admin-SDK.
        || collection == 'Teams CL 2026-27'
        || collection == 'Spiele CL 2026-27'
        || collection == 'Punkte Spieler CL 2026-27'
        || (collection == 'app_meta' && docId == 'turnier_cl2627')
        || (collection == 'public_cache' && (
             docId == 'cl2627_fixtures'
          || docId == 'cl2627_points_delta_current'
          || docId.matches('cl2627_points_shard_[0-9][0-9]')
        ))
        || (collection == 'Admin Auto Points Logs WM 2026' && isAdmin());

      // ── Tippgruppen: get fuer jeden Angemeldeten (Doc-ID = Geheimnis des
      //    Einladungs-Links – der Bestaetigungs-Dialog zeigt vor dem
      //    Beitritt Ersteller + Mitglieder). list bewusst enger: nur
      //    oeffentliche Gruppen bzw. die eigene Mitgliedschaft, jeweils
      //    query-gebunden (where visibility=='public' bzw.
      //    where memberUids array-contains eigene UID). Eine ungefilterte
      //    Query wuerde private Gruppen ausliefern und wird abgelehnt.
      allow get:
        if collection == 'tippgruppen'
        && request.auth != null;

      allow list:
        if collection == 'tippgruppen'
        && request.auth != null
        && (
             resource.data.visibility == 'public'
          || request.auth.uid in resource.data.memberUids
        );

      allow create:
        if (
            collection == 'Teams WM 2026'
            && teamWritesAllowed()
            && validTeamCreate()
            && (isAdmin() || docId == request.auth.uid)
        )
        || (
            collection == 'app_meta'
            && docId == 'turnier_wm2026'
            && isAdmin()
        )
        // ── CL 2026/27 (produktiv): Teams anlegen bis zum ersten
        //    Ligaphasen-Spiel. Ohne diesen Zweig lief jede Einreichung in
        //    der CL-Ansicht in ein permission-denied ("Fehler beim
        //    Speichern"), weil nur die WM-Collection gedeckt war. Mehrere
        //    Teams pro Account sind hier ausgeschlossen:
        //    die Doc-ID muss die eigene UID sein (siehe Hinweis oben) –
        //    nur der Admin darf fuer Testteams weitere Dokumente anlegen.
        //    Die zusaetzliche "ein Team pro E-Mail"-Regel (mehrere UIDs,
        //    gleiche Adresse) setzt weiterhin der Client durch (auth.js).
        || (
            collection == 'Teams CL 2026-27'
            && clTeamCreatesAllowed()
            && validTeamCreate()
            && (isAdmin() || docId == request.auth.uid)
        )
        || (
            collection == 'app_meta'
            && docId == 'turnier_cl2627'
            && isAdmin()
        )
        // ── Tippgruppen anlegen (verifiziert, selbst einziges Mitglied).
        || (
            collection == 'tippgruppen'
            && validTippgruppeCreate()
        );

      allow update:
        if (
            collection == 'Teams WM 2026'
            && teamWritesAllowed()
            && validTeamUpdate()
        )
        || (
            collection == 'app_meta'
            && docId == 'turnier_wm2026'
            && (
                isAdmin()
                || (isVerified() && isTeamsVersionBumpOnly())
            )
        )
        // ── CL 2026/27 (produktiv): eigenes Team aktualisieren + teamsVersion-Bump.
        //    Kein Deadline-Gate (Transferfenster laeuft waehrend der Saison,
        //    siehe clTeamCreatesAllowed).
        || (
            collection == 'Teams CL 2026-27'
            && validTeamUpdate()
        )
        || (
            collection == 'app_meta'
            && docId == 'turnier_cl2627'
            && (
                isAdmin()
                || (isVerified() && isTeamsVersionBumpOnly())
            )
        )
        // ── Tippgruppen: ausschliesslich Selbst-Beitritt/-Austritt.
        || (
            collection == 'tippgruppen'
            && validTippgruppeUpdate()
        );

      allow delete:
        if (
            collection == 'Teams WM 2026'
            && teamWritesAllowed()
            && validTeamDelete()
        )
        || (
            collection == 'app_meta'
            && docId == 'turnier_wm2026'
            && isAdmin()
        )
        // ── CL 2026/27 (produktiv): eigenes Team loeschen (gleiches
        //    Zeitfenster wie das Anlegen).
        || (
            collection == 'Teams CL 2026-27'
            && clTeamCreatesAllowed()
            && validTeamDelete()
        )
        || (
            collection == 'app_meta'
            && docId == 'turnier_cl2627'
            && isAdmin()
        )
        // ── Tippgruppen loeschen: nur Ersteller oder Admin.
        || (
            collection == 'tippgruppen'
            && validTippgruppeDelete()
        );
    }

    // Admin-Audit-Logs fuer den Auto-Punkte-Sync.
    // Writes laufen ausschliesslich ueber das Firebase Admin SDK im
    // GitHub-Action-Script; Client-Schreibzugriffe bleiben verboten.
    match /{collection}/{docId}/{subdocument=**} {
      allow read:
        if collection == 'Admin Auto Points Logs WM 2026' && isAdmin();
      allow write:
        if false;
    }

    // Default-Deny fuer alles andere. Schreibzugriffe auf
    // 'Spiele WM 2026' und 'Punkte Spieler WM 2026' laufen
    // ausschliesslich ueber das Admin-SDK in den Cron-Skripten
    // (siehe scripts/sync-fixtures.js und scripts/auto-points-upload.js);
    // das Admin-SDK umgeht diese Rules.
    match /{document=**} {
      allow read:  if false;
      allow write: if false;
    }
  }
}
